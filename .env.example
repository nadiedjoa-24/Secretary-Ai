# OpenAI API key (chat, transcription and structured extraction)
OPENAI_API_KEY=

# Gmail account read by the mail agent. Requires 2-step verification and an app password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Random string used by Flask to sign session cookies
FLASK_SECRET_KEY=

# Optional: Google Cloud service account key used for French text-to-speech
GOOGLE_TTS_KEY_FILE=google_cloud_tts_key.json

# Optional: microphone index as listed by PyAudio, defaults to the system microphone
AUDIO_DEVICE_INDEX=
