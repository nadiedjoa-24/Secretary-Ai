# Language models: "openai" (default) or "groq", which has a free tier (https://console.groq.com/keys).
# Only the key of the chosen provider is needed.
AI_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=

# Gmail account read by the mail agent. Requires 2-step verification and an app password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Random string used by Flask to sign session cookies
FLASK_SECRET_KEY=

# Speech synthesis: "openai" (default, needs the openai provider), "google" for Google Cloud
# Text-to-Speech, which needs a service account key file, or "browser" to let the web page
# read the answers with the browser's own French voice, for free
TTS_ENGINE=openai
GOOGLE_TTS_KEY_FILE=google_cloud_tts_key.json

# Public demo: fictional mailbox instead of Gmail, and a cap on AI requests per visitor and per hour
DEMO_MODE=0
AI_REQUESTS_PER_HOUR=0

# Command line voice mode only: microphone index as listed by PyAudio, defaults to the system microphone
AUDIO_DEVICE_INDEX=
