# OpenAI API key (chat, transcription, structured extraction and default speech synthesis)
OPENAI_API_KEY=

# Gmail account read by the mail agent. Requires 2-step verification and an app password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Random string used by Flask to sign session cookies
FLASK_SECRET_KEY=

# Speech synthesis: "openai" (default) or "google" for Google Cloud Text-to-Speech,
# which needs a service account key file
TTS_ENGINE=openai
GOOGLE_TTS_KEY_FILE=google_cloud_tts_key.json

# Public demo: fictional mailbox instead of Gmail, and a cap on AI requests per visitor and per hour
DEMO_MODE=0
AI_REQUESTS_PER_HOUR=0

# Command line voice mode only: microphone index as listed by PyAudio, defaults to the system microphone
AUDIO_DEVICE_INDEX=
